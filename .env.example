# Copy to .env and change the values. Never commit .env.
POSTGRES_USER=game_admin
POSTGRES_PASSWORD=password_you_know
POSTGRES_DB=invest_game
DATABASE_URL=postgresql+psycopg2://game_admin:password_you_know@db:5432/invest_game
# Protects POST /api/admin/content. Leave empty to disable content import.
ADMIN_KEY=
# The address players open, e.g. http://192.168.0.10:8080. start.py finds and sets it for you;
# fill it in only if you run `docker compose up` yourself.
PUBLIC_URL=